<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[globals [
  world-state
  successful-learning?
  tests-per-round
]

turtles-own [
  belief-fi2
  last-result
  result-history
  strategy
  current-test
  inertia-left
  group-id
]

to setup
  clear-all

  set world-state "phi2"
  set successful-learning? false

  set tests-per-round 1

  create-turtles num-turtles [
    set shape "circle"
    set size 2
    set belief-fi2 random-float 1
    set last-result []
    set result-history []
    set current-test ""
    set inertia-left inertia-rounds

    ;; Divide agents into two groups.
    ;; First half are group 0, second half are group 1.
    ifelse who < num-turtles / 2
    [
      set group-id 0
    ]
    [
      set group-id 1
    ]

    ;; One slider controls both EGS and RI.
    ;; If percent-egs-and-ri-agents = 20:
    ;; 20% are EGS, 20% are RI, and 60% are CBN.

    let shared-percent min (list percent-egs-and-ri-agents 50)

    let num-egs round (num-turtles * shared-percent / 100)
    let num-ri round (num-turtles * shared-percent / 100)

    ;; Safety check.
    if num-egs + num-ri > num-turtles [
      set num-ri num-turtles - num-egs
    ]

    if who < num-egs [
      set strategy "Epsilon Greedy Strategy"
      set color green
    ]

    if who >= num-egs and who < num-egs + num-ri [
      set strategy "Rational Inertia"
      set color orange
    ]

    if who >= num-egs + num-ri [
      set strategy "Credence Based Norm"
      set color blue
    ]
  ]

  ;; Put turtles in a circle.
  ask turtles [
    let angle (who * 360 / count turtles)
    setxy (cos angle * 8) (sin angle * 8)
    set heading angle + 90
  ]

  update-network
  update-labels
  reset-ticks
end

to go
  update-network

  ;; Each agent makes exactly one choice per round.
  ask turtles [
    set result-history []

    let chosen-test ""

    ;; EGS agents choose A1 or A2 probabilistically once per round.
    if strategy = "Epsilon Greedy Strategy" [
      set chosen-test choose-epsilon-test
    ]

    ;; CBN and RI agents choose one action once per round.
    if strategy != "Epsilon Greedy Strategy" [
      set chosen-test choose-round-test
    ]

    let result run-experiment chosen-test
    set result-history lput (list chosen-test result) result-history

    set last-result result-history
  ]

  ;; Everyone updates from their own result and neighbours' results.
  ask turtles [
    update-beliefs
  ]

  update-labels
  tick

  ;; Stop condition 1:
  ;; No agent generated any new information this round.
  ;; This means everyone chose A1.
  if all? turtles [ empty? (filter [ obs -> item 1 obs != "" ] result-history) ] [
    set successful-learning? false
    stop
  ]

  ;; Stop condition 2:
  ;; Everyone strongly believes phi2.
  if all? turtles [ belief-fi2 > 0.9999 ] [
    set successful-learning? (world-state = "phi2")
    stop
  ]
end

to-report choose-round-test
  ;; Used by Credence Based Norm and Rational Inertia.
  ;;
  ;; A2 is the informative experiment.
  ;; A1 means not performing the informative experiment.
  ;;
  ;; Agents choose A2 when they believe phi2 is at least as likely as phi1.

  let best-test ifelse-value (belief-fi2 >= 0.5) ["A2"] ["A1"]

  if strategy = "Credence Based Norm" [
    report best-test
  ]

  if strategy = "Rational Inertia" [
    ;; If the agent has no current test, initialize it.
    if current-test = "" [
      set current-test best-test
      set inertia-left inertia-rounds
      report current-test
    ]

    ;; If the currently best test differs from the current test,
    ;; do not switch immediately.
    if best-test != current-test [
      if inertia-left > 0 [
        set inertia-left inertia-left - 1
        report current-test
      ]

      ;; After waiting, switch.
      set current-test best-test
      set inertia-left inertia-rounds
      report current-test
    ]

    ;; If the current test is still best, reset inertia.
    if best-test = current-test [
      set inertia-left inertia-rounds
      report current-test
    ]
  ]

  report best-test
end

to-report choose-epsilon-test
  ;; Epsilon-greedy-style mixed testing:
  ;;
  ;; With probability 0.5, choose A2.
  ;; With probability 0.5, choose A1.
  ;;
  ;; A1 gives no new information.
  ;; A2 gives new information.

  ifelse random-float 1 < 0.5
    [ report "A2" ]
    [ report "A1" ]
end

to-report run-experiment [chosen-test]
  ;; Generate a + / - result only for agents who chose A2.
  ;; Agents who choose A1 receive no new information.

  if chosen-test = "A1" [
    report ""
  ]

  if chosen-test = "A2" [
    let pplus ifelse-value (world-state = "phi2") [0.55] [0.45]

    report ifelse-value (random-float 1 < pplus) ["+"] ["-"]
  ]
end

to update-beliefs
  ;; First update on own results.
  ;; Own evidence is always treated with standard Bayesian conditionalization.

  foreach result-history [
    obs ->
      let result item 1 obs

      if result != "" [
        set belief-fi2 bayes belief-fi2 result
      ]
  ]

  ;; Then update on connected neighbours' results.
  ;;
  ;; In-group evidence:
  ;;   standard Bayesian conditionalization.
  ;;
  ;; Out-group evidence:
  ;;   Jeffrey conditionalization with distrust parameter m.

  ask link-neighbors [
    let neighbour-history result-history
    let neighbour-group group-id

    ask myself [
      foreach neighbour-history [
        obs ->
          let result item 1 obs

          if result != "" [
            ifelse neighbour-group = group-id
            [
              ;; In-group source: ordinary Bayesian update.
              set belief-fi2 bayes belief-fi2 result
            ]
            [
              ;; Out-group source: Jeffrey conditionalization.
              set belief-fi2 jeffrey-update belief-fi2 result m
            ]
          ]
        ]
      ]
    ]
  
end

to-report bayes [p r]
  ;; Standard Bayesian conditionalization on result r.
  ;;
  ;; p is prior Cr(phi2).
  ;; r is either "+" or "-".
  ;;
  ;; Likelihoods:
  ;;   P(+ | phi2) = 0.55
  ;;   P(+ | phi1) = 0.45
  ;;   P(- | phi2) = 0.45
  ;;   P(- | phi1) = 0.55

  let l2 ifelse-value (r = "+") [0.55] [0.45]
  let l1 ifelse-value (r = "+") [0.45] [0.55]

  report (p * l2) / ((p * l2) + ((1 - p) * l1))
end

to-report jeffrey-update [p r distrust]
  ;; Jeffrey conditionalization for out-group evidence.
  ;;
  ;; H is phi2.
  ;; E is the reported result r, either "+" or "-".
  ;;
  ;; P_f(H) =
  ;;   P_i(H | E) * P_f(E)
  ;;   +
  ;;   P_i(H | not E) * P_f(not E)
  ;;
  ;; Distrust rule:
  ;;
  ;;   P_f(E) = 1 - distrust * (1 - P_i(E))
  ;;
  ;; If distrust = 0:
  ;;   P_f(E) = 1
  ;;   so out-group evidence is treated as certain,
  ;;   equivalent to ordinary Bayesian conditionalization.
  ;;
  ;; If distrust = 1:
  ;;   P_f(E) = P_i(E)
  ;;   so the out-group report causes no belief change.

  let pi-e predictive-probability p r
  let pf-e 1 - distrust * (1 - pi-e)
  let pf-not-e 1 - pf-e

  let p-h-given-e bayes p r
  let opposite-result opposite-evidence r
  let p-h-given-not-e bayes p opposite-result

  report (p-h-given-e * pf-e) + (p-h-given-not-e * pf-not-e)
end

to-report predictive-probability [p r]
  ;; P_i(E), where E is the observed result r.
  ;;
  ;; p is current Cr(phi2).
  ;; r is either "+" or "-".

  let l2 ifelse-value (r = "+") [0.55] [0.45]
  let l1 ifelse-value (r = "+") [0.45] [0.55]

  report (p * l2) + ((1 - p) * l1)
end

to-report opposite-evidence [r]
  ;; Since the only possible informative outcomes are "+" and "-",
  ;; not-E is represented by the opposite outcome.

  if r = "+" [
    report "-"
  ]

  if r = "-" [
    report "+"
  ]

  report ""
end

to update-network
  ;; Rebuild the network according to the selected communication structure.
  clear-links

  if network-structure = "Cycle" [
    make-cycle-network
  ]

  if network-structure = "Wheel" [
    make-wheel-network
  ]

  if network-structure = "Complete" [
    make-complete-network
  ]
end

to make-cycle-network
  ;; Cycle:
  ;; Everyone is connected only with their two neighbours.

  let n count turtles

  if n < 2 [
    stop
  ]

  ask turtles [
    let next-id (who + 1) mod n
    create-link-with turtle next-id
  ]
end

to make-wheel-network
  ;; Wheel:
  ;; Turtle 0 is the central agent.
  ;; Turtle 0 connects to everyone.
  ;; All other turtles are connected with their neighbours.

  let n count turtles

  if n < 2 [
    stop
  ]

  ;; Outer cycle among turtles except turtle 0.
  if n > 2 [
    ask turtles with [who != 0] [
      let next-id who + 1

      if next-id >= n [
        set next-id 1
      ]

      create-link-with turtle next-id
    ]
  ]

  ;; Central turtle connects to everyone else.
  ask turtle 0 [
    create-links-with other turtles
  ]
end

to make-complete-network
  ;; Complete:
  ;; Everyone is connected with everyone.

  ask turtles [
    create-links-with other turtles
  ]
end

to update-labels
  ;; Show each agent's strategy, group, and current belief.

  ask turtles [
    let short-strategy ""

    if strategy = "Credence Based Norm" [
      set short-strategy "CBN"
    ]

    if strategy = "Epsilon Greedy Strategy" [
      set short-strategy "EGS"
    ]

    if strategy = "Rational Inertia" [
      set short-strategy "RI"
    ]

    set label (word short-strategy
                    " G" group-id
                    "\np(phi2)=" precision belief-fi2 2)
  ]
end]]></code>
